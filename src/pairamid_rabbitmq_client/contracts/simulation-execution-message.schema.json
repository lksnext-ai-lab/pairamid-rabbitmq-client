{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://itool.example/schemas/simulation-execution-message/2.0",
  "title": "Mensaje de ejecución de simulación",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "message_id",
    "simulation_execution_id",
    "run_id",
    "attempt_id",
    "simulation_key",
    "submitted_by",
    "input",
    "requested_at"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "message_id": {
      "type": "string",
      "format": "uuid",
      "description": "Identificador de esta publicación."
    },
    "simulation_execution_id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "ID de ejecución asignado por PostgreSQL al insertar; entero positivo representable exactamente en JSON/JavaScript."
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "attempt_id": {
      "type": "string",
      "format": "uuid"
    },
    "simulation_key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,99}$",
      "description": "Identifica una simulación configurada y resuelve internamente su partner y schema de inputs."
    },
    "submitted_by": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject"
      ],
      "properties": {
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "client_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "input": {
      "type": "object",
      "description": "JSON de entrada ya validado conforme al schema de la simulación. Se transporta embebido para que el adaptador del partner lo materialice localmente."
    },
    "requested_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
