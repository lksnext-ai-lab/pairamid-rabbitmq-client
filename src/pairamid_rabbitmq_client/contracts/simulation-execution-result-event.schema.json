{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://itool.example/schemas/simulation-execution-result-event/2.0",
  "title": "Evento terminal de resultado de una simulación",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "event_type",
    "simulation_execution_id",
    "run_id",
    "attempt_id",
    "simulation_key",
    "finished_at"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "enum": [
        "simulation_execution.succeeded",
        "simulation_execution.failed"
      ]
    },
    "simulation_execution_id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "ID de ejecución asignado por PostgreSQL al insertar; entero positivo representable exactamente en JSON/JavaScript."
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "attempt_id": {
      "type": "string",
      "format": "uuid"
    },
    "simulation_key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,99}$"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "payload"
      ],
      "properties": {
        "payload": {
          "$ref": "https://itool.example/schemas/simulation-execution-result-payload/2.0",
          "description": "Payload JSON que publica el adaptador. FastAPI lo valida y lo almacena en Garage."
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "uri",
              "sha256",
              "size_bytes"
            ],
            "properties": {
              "uri": {
                "type": "string",
                "format": "uri"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "size_bytes": {
                "type": "integer",
                "minimum": 0
              },
              "media_type": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "summary": {
          "type": "object"
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,99}$"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "retryable": {
          "const": false,
          "description": "Un evento terminal de error procede de un fallo definitivo tras los reintentos internos del partner."
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "simulation_execution.succeeded"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "required": [
          "result"
        ],
        "not": {
          "required": [
            "error"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "simulation_execution.failed"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "required": [
          "error"
        ],
        "not": {
          "required": [
            "result"
          ]
        }
      }
    }
  ]
}
