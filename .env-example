# RabbitMQ connection
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_DEFAULT_VHOST=/

# Keycloak client credentials. Set the real secret in the local environment.
OAUTH2_TOKEN_URL=https://keycloak.example.com/realms/pairamid/protocol/openid-connect/token
RABBITMQ_CLIENT_ID=irtjv-rabbitmq-client
RABBITMQ_CLIENT_SECRET=replace-with-local-keycloak-secret

# Partner adapter and polling
# Optional consistency guard; partner_id and queue names come from token claims.
PARTNER_ID=irtjv
CONSUMER_POLL_INTERVAL_SECONDS=30
SIMULATION_DIR=./simulations