RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_DEFAULT_VHOST=/
RABBITMQ_CLIENT_ID=irtjv-rabbitmq-client
RABBITMQ_CLIENT_SECRET=replace-with-the-service-secret
OAUTH2_TOKEN_URL=https://keycloak.example.com/realms/pairamid/protocol/openid-connect/token
# Optional consistency guard; partner_id is read from the Keycloak access token.
PARTNER_ID=irtjv
SIMULATION_DIR=./simulations
CONSUMER_POLL_INTERVAL_SECONDS=30
